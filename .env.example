# Copy this file to .env and fill real values

# Groq model settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=1
GROQ_MAX_TOKENS=1200
GROQ_REQUESTS_PER_SECOND=0.2
GROQ_RATE_CHECK_SECONDS=0.25

# Agent request settings
AGENT_TIMEOUT_SECONDS=90
AGENT_RECURSION_LIMIT=6
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_SECONDS=3
RATE_LIMIT_COOLDOWN_SECONDS=35

# MCP settings
MCP_BASE_URL=http://localhost:3002/sse

# Embedding model settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_LOCAL_FILES_ONLY=true
HF_TOKEN=

# Session memory settings
SESSION_MEMORY_STORE_PATH=session_memory_store
SESSION_MEMORY_RETRIEVE_K=4
